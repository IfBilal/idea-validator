# Names only. Copy to .env (git-ignored) and fill locally. In Kubernetes these become Secrets via scripts/create_secrets.sh.
# --- databases ---
POSTGRES_USER=idea
POSTGRES_PASSWORD=
POSTGRES_DB=idea_validator
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
# --- auth ---
JWT_SECRET=
INTERNAL_TOKEN=
# --- LLM provider (used ONLY by M5 /llm proxy) ---
# Provider, model aliases and the allow-listed provider host live in config/llm.yaml (a ConfigMap).
# Only the key of that provider is secret: one key, for the provider that the aliases point to.
LLM_API_KEY=
# --- data sources ---
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=
# --- scoring model ---
SCORER_MODEL_URL=              # release asset URL of the GGUF (downloaded via M5)
SCORER_MODEL_SHA256=
# --- UI ---
API_BASE_URL=/api
