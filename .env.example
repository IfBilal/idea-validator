# Names only. Copy to .env (git-ignored) and fill locally. In Kubernetes these become Secrets via scripts/create_secrets.sh.
# --- databases ---
POSTGRES_USER=idea
POSTGRES_PASSWORD=
POSTGRES_DB=idea_validator
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
# --- auth ---
JWT_SECRET=
INTERNAL_TOKEN=
# --- LLM provider (used ONLY by M5 /llm proxy) ---
LLM_PROVIDER=openai            # openai | anthropic | gemini | groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HOSTED_MODEL_DEFAULT=
HOSTED_MODEL_CHEAP=
# --- data sources ---
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=
# --- scoring model ---
SCORER_MODEL_URL=              # release asset URL of the GGUF (downloaded via M5)
SCORER_MODEL_SHA256=
# --- UI ---
API_BASE_URL=/api
