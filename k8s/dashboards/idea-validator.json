{
  "title": "Idea Validator",
  "uid": "idea-validator",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "tags": [
    "idea-validator",
    "m13"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cost per verdict",
      "description": "USD spent on traced steps divided by M11 verdicts over the last hour (agentops: trace_cost_usd_total, verdicts_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(trace_cost_usd_total[1h])) / clamp_min(sum(increase(verdicts_total[1h])), 1)",
          "legendFormat": "USD per verdict"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency per agent",
      "description": "p50 and p95 step latency by agent (agentops: agent_step_latency_seconds).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, agent) (rate(agent_step_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{agent}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(agent_step_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{agent}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "Share of traced tool and model calls served from a cache, by kind (agentops: cache_requests_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(cache_requests_total{result=\"hit\"}[5m])) / clamp_min(sum by (cache) (rate(cache_requests_total[5m])), 1e-9)",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fallbacks",
      "description": "Steps that used a fallback, per hour and agent (agentops: scorer_fallback_total, from TraceRecord.fallback).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (increase(scorer_fallback_total[1h]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Blocked injections",
      "description": "Injection attempts blocked, per hour and source. Emitted by tools (M5): blocked_injections_total{source} on its /metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (increase(blocked_injections_total[1h]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Budget stops",
      "description": "Runs stopped by the budget, per hour. Emitted by orchestrator (M3): runs_total{kind,status} with status=\"budget_stopped\" on its /metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(runs_total{status=\"budget_stopped\"}[1h]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ]
}
